# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=typeshala
POSTGRES_PASSWORD=typeshala_dev
POSTGRES_DB=typeshala_db
POSTGRES_HOST=db
POSTGRES_PORT=5432               # container-internal port (host: 5100)

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379                  # container-internal port (host: 5101)
REDIS_DB=0
# REDIS_PASSWORD=                # uncomment for prod

# ── JWT ────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5103","http://localhost:5104"]

# ── Frontend API URL ────────────────────────────────────────────────────────────
# For local-only access keep the default. When accessing from other devices/machines
# set this to the URL they use to reach the NGINX gateway (e.g. your domain or LAN IP).
VITE_API_URL=http://localhost:5104/api/v1

# ── Sentry (leave empty to disable) ───────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Seed / First superuser (optional) ─────────────────────────────────────────
# FIRST_SUPERUSER_EMAIL=admin@example.com
# FIRST_SUPERUSER_PASSWORD=SuperSecret1!
# FIRST_SUPERUSER_USERNAME=admin

# ── Monitoring (Grafana) ───────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
